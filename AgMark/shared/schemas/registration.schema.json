{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arcgrav:shared:schema:registration:1.0.0",
  "schema_id": "arcgrav.shared.schema.registration",
  "schema_version": "1.0.0",
  "title": "Shared Registration",
  "description": "Benchmark-neutral durable registration envelope for stable extension identities and implementation references.",
  "x-arcgrav-extension-policy": {
    "mode": "namespaced-additive",
    "extension_points": [
      "/extensions"
    ],
    "unknown_fields": "reject",
    "preserve_unknown_extensions": true,
    "shared_fields_overridable": false
  },
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "identityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "schemaIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version"
      ],
      "properties": {
        "schema_id": {
          "type": "string",
          "pattern": "^arcgrav\\.shared\\.schema\\.[a-z0-9._-]+$"
        },
        "schema_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "sha256"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "schema": {
          "$ref": "#/$defs/schemaIdentity"
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "availability": {
          "type": "string",
          "enum": [
            "retained",
            "not_produced",
            "unavailable",
            "invalid",
            "excluded",
            "missing",
            "failed",
            "completed_non_scorable",
            "scored",
            "not_applicable",
            "non_comparable"
          ]
        }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9._-]*:[^\\s]+$"
      },
      "additionalProperties": true,
      "description": "Opaque-preservable namespaced extension values. Consumers must preserve unknown entries and may not reinterpret shared fields."
    },
    "validationIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "source_id",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "json_pointer": {
          "type": "string",
          "pattern": "^(?:/(?:[^~/]|~0|~1)*)*$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "$ref": "#/$defs/schemaIdentity"
        }
      }
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "extensions",
    "registration_id",
    "registration_version",
    "registration_kind",
    "status",
    "contracts",
    "implementation_artifacts"
  ],
  "properties": {
    "schema_id": {
      "const": "arcgrav.shared.schema.registration"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    },
    "registration_id": {
      "type": "string",
      "minLength": 1
    },
    "registration_version": {
      "$ref": "#/$defs/semanticVersion"
    },
    "registration_kind": {
      "type": "string",
      "enum": [
        "benchmark",
        "runner",
        "metric",
        "scorer",
        "report_configuration",
        "golden_runtime",
        "reconstruction_procedure",
        "other"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "deprecated",
        "disabled"
      ]
    },
    "contracts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identityRef"
      }
    },
    "implementation_artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifactRef"
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
