{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arcgrav:shared:schema:validation-result:1.0.0",
  "schema_id": "arcgrav.shared.schema.validation-result",
  "schema_version": "1.0.0",
  "title": "Validation Result",
  "description": "Deterministic structural validation result identifying exact schema, source artifact, stable issues, and JSON Pointers where applicable.",
  "x-arcgrav-extension-policy": {
    "mode": "namespaced-additive",
    "extension_points": [
      "/extensions"
    ],
    "unknown_fields": "reject",
    "preserve_unknown_extensions": true,
    "shared_fields_overridable": false
  },
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "identityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "schemaIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version"
      ],
      "properties": {
        "schema_id": {
          "type": "string",
          "pattern": "^arcgrav\\.shared\\.schema\\.[a-z0-9._-]+$"
        },
        "schema_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "sha256"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "schema": {
          "$ref": "#/$defs/schemaIdentity"
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "availability": {
          "type": "string",
          "enum": [
            "retained",
            "not_produced",
            "unavailable",
            "invalid",
            "excluded",
            "missing",
            "failed",
            "completed_non_scorable",
            "scored",
            "not_applicable",
            "non_comparable"
          ]
        }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9._-]*:[^\\s]+$"
      },
      "additionalProperties": true,
      "description": "Opaque-preservable namespaced extension values. Consumers must preserve unknown entries and may not reinterpret shared fields."
    },
    "validationIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "source_id",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "json_pointer": {
          "type": "string",
          "pattern": "^(?:/(?:[^~/]|~0|~1)*)*$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "$ref": "#/$defs/schemaIdentity"
        }
      }
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "extensions",
    "validation_id",
    "schema",
    "source_artifact",
    "valid",
    "issues"
  ],
  "properties": {
    "schema_id": {
      "const": "arcgrav.shared.schema.validation-result"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    },
    "validation_id": {
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "$ref": "#/$defs/schemaIdentity"
    },
    "source_artifact": {
      "$ref": "#/$defs/artifactRef"
    },
    "valid": {
      "type": "boolean"
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/validationIssue"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "valid": {
            "const": true
          }
        },
        "required": [
          "valid"
        ]
      },
      "then": {
        "properties": {
          "issues": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "valid": {
            "const": false
          }
        },
        "required": [
          "valid"
        ]
      },
      "then": {
        "properties": {
          "issues": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
