      "enum": [
        "planned",
        "unavailable",
        "failed",
        "completed"
      ]
    },
    "configuration_match": {
      "$ref": "#/$defs/configuration"
    },
    "runtime_equivalence": {
      "$ref": "#/$defs/runtime"
    },
    "capabilities": {
      "$ref": "#/$defs/capabilities"
    },
    "replay_summary": {
      "$ref": "#/$defs/replay_summary"
    },
    "requests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/request"
      }
    },
    "provenance": {
      "type": "string",
      "minLength": 1
    },
    "evidence_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9._-]*:[^\\s]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/field"
      }
    }
  }
}
