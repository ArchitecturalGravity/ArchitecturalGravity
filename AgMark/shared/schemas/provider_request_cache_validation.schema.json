{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arcgrav:telemetry:provider-request-cache-validation:2.0.0",
  "schema_id": "arcgrav.shared.schema.provider-request-cache-validation",
  "schema_version": "2.0.0",
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "availability",
        "source",
        "method",
        "reason",
        "evidence_references"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "availability": {
          "enum": [
            "available",
            "partial",
            "unavailable",
            "inferred",
            "non_comparable"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "evidence_references": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "availability": {
                "enum": [
                  "unavailable",
                  "non_comparable"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ],
                "minLength": 1
              }
            }
          }
        }
      ]
    },
