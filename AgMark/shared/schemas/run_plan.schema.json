{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arcgrav:shared:schema:run-plan:1.0.0",
  "schema_id": "arcgrav.shared.schema.run-plan",
  "schema_version": "1.0.0",
  "title": "Run Plan",
  "description": "Complete pre-acceptance plan for the case x treatment x repetition x execution-boundary matrix.",
  "x-arcgrav-extension-policy": {
    "mode": "namespaced-additive",
    "extension_points": [
      "/extensions"
    ],
    "unknown_fields": "reject",
    "preserve_unknown_extensions": true,
    "shared_fields_overridable": false
  },
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "identityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "schemaIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version"
      ],
      "properties": {
        "schema_id": {
          "type": "string",
          "pattern": "^arcgrav\\.shared\\.schema\\.[a-z0-9._-]+$"
        },
        "schema_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "sha256"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "schema": {
          "$ref": "#/$defs/schemaIdentity"
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "availability": {
          "type": "string",
          "enum": [
            "retained",
            "not_produced",
            "unavailable",
            "invalid",
            "excluded",
            "missing",
            "failed",
            "completed_non_scorable",
            "scored",
            "not_applicable",
            "non_comparable"
          ]
        }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9._-]*:[^\\s]+$"
      },
      "additionalProperties": true,
      "description": "Opaque-preservable namespaced extension values. Consumers must preserve unknown entries and may not reinterpret shared fields."
    },
    "validationIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "source_id",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "json_pointer": {
          "type": "string",
          "pattern": "^(?:/(?:[^~/]|~0|~1)*)*$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "$ref": "#/$defs/schemaIdentity"
        }
      }
    },
    "plannedObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "observation_id",
        "case_id",
        "treatment_id",
        "repetition",
        "execution_boundary_fingerprint",
        "input"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "observation_id": {
          "type": "string",
          "minLength": 1
        },
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "treatment_id": {
          "type": "string",
          "minLength": 1
        },
        "repetition": {
          "type": "integer",
          "minimum": 1
        },
        "execution_boundary_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256"
          ],
          "properties": {
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "reference": {
              "type": "string",
              "minLength": 1
            },
            "byte_length": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "extensions",
    "run_plan_id",
    "canonicalization",
    "plan_sha256",
    "benchmark",
    "case_set",
    "treatment_set",
    "execution_boundary",
    "execution_boundary_fingerprint",
    "repetitions",
    "golden_required",
    "contracts",
    "observations"
  ],
  "properties": {
    "schema_id": {
      "const": "arcgrav.shared.schema.run-plan"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    },
    "run_plan_id": {
      "type": "string",
      "minLength": 1
    },
    "canonicalization": {
      "const": "arcgrav.canonical-json.v1"
    },
    "plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "benchmark": {
      "$ref": "#/$defs/identityRef"
    },
    "case_set": {
      "$ref": "#/$defs/identityRef"
    },
    "treatment_set": {
      "$ref": "#/$defs/identityRef"
    },
    "execution_boundary": {
      "$ref": "#/$defs/artifactRef"
    },
    "execution_boundary_fingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "repetitions": {
      "type": "integer",
      "minimum": 1
    },
    "golden_required": {
      "type": "boolean"
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identityRef"
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/plannedObservation"
      }
    }
  }
}
