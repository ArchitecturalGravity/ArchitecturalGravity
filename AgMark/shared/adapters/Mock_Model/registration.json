{
  "schema_id": "arcgrav.shared.schema.registration",
  "schema_version": "1.0.0",
  "registration_id": "arcgrav.mock-model.runner",
  "registration_version": "1.0.0",
  "registration_kind": "runner",
  "status": "active",
  "contracts": [
    {
      "id": "arcgrav.shared.runner-invocation",
      "version": "2.0.0"
    }
  ],
  "extensions": {
    "arcgrav.adapters:entry_point": "AgMark.shared.adapters.Mock_Model:MockRunner",
    "arcgrav.adapters:supported_controls": [
      {
        "name": "model_id",
        "kind": "choice",
        "required": true,
        "comparison_relevant": true,
        "mapping": "/model/model_id"
      },
      {
        "name": "request_timeout_ms",
        "kind": "integer",
        "required": true,
        "default": 120000,
        "minimum": 1,
        "comparison_relevant": true,
        "mapping": "/timeout_policy/request_timeout_ms"
      },
      {
        "name": "maximum_attempts",
        "kind": "integer",
        "required": true,
        "default": 1,
        "values": [
          1
        ],
        "comparison_relevant": true,
        "mapping": "/retry_policy/maximum_attempts"
      }
    ],
    "arcgrav.adapters:fixed_controls": [
      {
        "name": "memory_policy",
        "value": "disabled"
      },
      {
        "name": "request_framing",
        "value": "mock_json_v1"
      },
      {
        "name": "sampling_mode",
        "value": "deterministic"
      },
      {
        "name": "tool_policy",
        "value": "none"
      }
    ],
    "arcgrav.adapters:access_methods": [
      {
        "type": "local_process",
        "transport": "subprocess",
        "client_name": "agmark-mock-worker",
        "authentication_class": "not_applicable"
      }
    ],
    "arcgrav.adapters:planning_probe": {
      "entry_point": "AgMark.shared.adapters.Mock_Model.catalog:probe_planning_identity",
      "implementation_artifact_id": "AgMark/shared/adapters/Mock_Model/catalog.py"
    },
    "arcgrav.adapters:model_discovery": {
      "entry_point": "AgMark.shared.adapters.Mock_Model.catalog:probe_model_discovery",
      "implementation_artifact_id": "AgMark/shared/adapters/Mock_Model/catalog.py",
      "determining_controls": [],
      "surface": {
        "kind": "bundled_mock_catalog",
        "provider_submission": false
      },
      "choice_projection": {
        "default_first": true,
        "canonical_value": "model_id",
        "display_value": "label",
        "selection_modes": [
          "explicit"
        ],
        "normal_path_free_text": false
      },
      "scenario_projection": {
        "source": "scenario",
        "required": true,
        "runner_control": "model_id",
        "canonical_identity": "scenario_id",
        "display_value": "label",
        "applicable_model": "base_model_id",
        "canonical_model_mapping": "model_id",
        "default": "is_default"
      }
    },
    "arcgrav.adapters:runner_test": {
      "supported": true
    },
    "arcgrav.adapters:validation_replay": {
      "profile": "unsupported"
    },
    "arcgrav.adapters:evidence_class": "provider-free-mock-model-execution",
    "arcgrav.adapters:target_composition": {
      "target_class": "mock-model",
      "external_provider_submission": false,
      "runtime_provider": "AgMark Mock Model",
      "authentication_source": null
    },
    "arcgrav.adapters:request_framing": {
      "mode": "mock_json_v1",
      "serialization": "canonical UTF-8 JSON with separate base64 prompt and input",
      "prompt_input_preservation": "exact",
      "accepted_content_representations": [
        "bytes",
        "utf-8-text"
      ]
    },
    "arcgrav.adapters:response_retention": {
      "mode": "stdout_inline_extension",
      "hash": "sha256",
      "normalization": "none"
    },
    "arcgrav.adapters:telemetry_behavior": {
      "provider_reported_usage": false,
      "runner_measured_bytes": true,
      "stdout_stderr_hashes": true,
      "attempt_timing": true,
      "persisted_session": false
    },
    "arcgrav.adapters:visible_controls": [
      "request_timeout_ms"
    ]
  },
