  "capabilities": [
    "provider-free",
    "non-interactive",
    "isolated-observation-state",
    "exact-prompt-input-framing",
    "mixed-process-transcript-retention",
    "byte-telemetry",
    "cancellation"
  ],
  "limitations": [
    "Deterministic synthetic model for integration diagnostics, not comparative model capability evidence.",
    "Native packaged worker only. No provider credentials, provider sessions, token usage, cost, tools or replay telemetry are synthesized.",
    "Each observation uses a fresh Python process and temporary directory; maximum_attempts is one."
  ]
