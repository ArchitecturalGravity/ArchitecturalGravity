{
  "schema_id": "arcgrav.shared.schema.registration",
  "schema_version": "1.0.0",
  "extensions": {
    "arcgrav.adapters:launch_environment": {
      "supported_modes": [
        "native",
        "wsl"
      ],
      "default_mode_policy": {
        "windows": "wsl",
        "non_windows": "native_if_supported_else_unsupported"
      },
      "selectors": {
        "launch_mode": {
          "comparison_relevant": true,
          "required_before_planning": true
        },
        "codex_binary": {
          "comparison_relevant": true,
          "resolution": "selected_launch_environment"
        },
        "wsl_distribution": {
          "comparison_relevant": true,
          "wsl_only": true,
          "required_before_planning": true
        }
      },
      "native": {
        "codex_binary_default": "AgMark/shared/software_testing/adapters/codex_cli/fixtures/codex_protocol/arcgrav-mock-model-cli",
        "codex_binary_resolution": "launch_environment_path"
      },
      "wsl": {
        "host_platform": "windows",
        "launcher_default": "C:\\Windows\\System32\\wsl.exe",
        "distribution_default": "Ubuntu",
        "codex_binary_default": "AgMark/shared/software_testing/adapters/codex_cli/fixtures/codex_protocol/arcgrav-mock-model-cli",
        "codex_binary_resolution": "selected_distribution",
        "workdir_policy": "wsl_native_mktemp",
        "authentication_policy": "none"
      },
      "model_identity": {
        "selection": "discovery_backed_explicit",
        "control": "model_id",
        "concrete_identity_required": true,
        "catalog_surface": "model/list"
      }
    },
    "arcgrav.adapters:supported_controls": [
      {
        "name": "launch_mode",
        "kind": "choice",
        "required": true,
        "values": [
          "native",
          "wsl"
        ],
        "comparison_relevant": true,
        "mapping": "/extensions/openai.codex_cli:launch_environment/launch_mode"
      },
      {
        "name": "wsl_distribution",
        "kind": "text",
        "required": true,
        "comparison_relevant": true,
        "mapping": "/extensions/openai.codex_cli:launch_environment/wsl_distribution"
      },
      {
        "name": "codex_binary",
        "kind": "text",
        "required": true,
        "comparison_relevant": true,
        "mapping": "/access_method/client_name"
      },
      {
        "name": "model_id",
        "kind": "choice",
        "required": true,
        "comparison_relevant": true,
        "mapping": "/model/model_id"
      },
      {
        "name": "reasoning_effort",
        "kind": "choice",
        "required": true,
        "comparison_relevant": true,
        "mapping": "/extensions/openai.codex_cli:reasoning_effort"
      },
      {
        "name": "model_selection_mode",
        "kind": "choice",
        "required": true,
        "values": [
          "explicit"
        ],
        "default": "explicit",
        "comparison_relevant": false,
        "mapping": "/extensions/openai.codex_cli:model_selection_mode"
      },
      {
        "name": "approval_mode",
        "kind": "choice",
        "required": true,
        "values": [
          "full_auto"
        ],
        "comparison_relevant": true,
        "mapping": "/tools/policy"
      },
      {
        "name": "request_timeout_ms",
        "kind": "integer",
        "required": true,
        "default": 120000,
        "minimum": 1,
        "comparison_relevant": true,
        "mapping": "/timeout_policy/request_timeout_ms"
      },
      {
        "name": "maximum_attempts",
        "kind": "integer",
        "required": true,
        "default": 1,
        "values": [
          1
        ],
        "comparison_relevant": true,
        "mapping": "/retry_policy/maximum_attempts"
      },
      {
        "name": "capture_mode",
        "kind": "choice",
        "required": false,
        "values": [
          "session",
          "telemetry",
          "deep_telemetry"
        ],
        "default": "telemetry",
        "comparison_relevant": true,
        "mapping": "/extensions/agmark.telemetry:profile/capture_mode"
      },
      {
        "name": "diagnostic_privacy_acknowledged",
        "kind": "choice",
        "required": false,
        "values": [
          "not_acknowledged",
          "acknowledged:agmark.original-diagnostics.stock-rollout@2.0.0"
        ],
        "default": "not_acknowledged",
        "comparison_relevant": true,
        "mapping": "/extensions/agmark.telemetry:profile/diagnostic_privacy_acknowledged"
      }
    ],
    "arcgrav.adapters:fixed_controls": [
      {
        "name": "memory_policy",
        "value": "disabled"
      },
      {
        "name": "request_framing",
        "value": "codex_cli"
      },
      {
        "name": "sampling_mode",
        "value": "provider_default"
      },
      {
        "name": "tool_policy",
        "value": "workspace_write"
      }
    ],
    "arcgrav.adapters:access_methods": [
      {
        "type": "cli",
        "transport": "subprocess",
        "client_name": "arcgrav-mock-model-cli",
        "authentication_class": "not_applicable"
      }
    ],
    "arcgrav.adapters:request_framing": {
      "mode": "codex_cli",
      "serialization": "prompt bytes, two LF bytes, input bytes",
      "prompt_input_preservation": "exact",
      "accepted_content_representations": [
        "bytes",
        "utf-8-text"
      ]
    },
    "arcgrav.adapters:telemetry_behavior": {
      "provider_reported_usage": false,
      "runner_measured_bytes": true,
      "stdout_stderr_hashes": true,
      "runtime_token_counters": true,
      "billing_components": "source-defined runtime usage; no billing authority",
      "tool_trace": "Exact-thread persisted rollout call items and outcomes",
      "attempt_timing": true,
      "measurement_schema": {
        "id": "arcgrav.shared.schema.attempt-measurements",
        "version": "1.0.0"
      }
    },
    "arcgrav.adapters:response_retention": {
      "mode": "last-completed-agent-message-utf8-inline-extension-base64",
      "hash": "sha256",
      "normalization": "none",
      "final_response_channel": {
        "kind": "stdout",
        "exact_bytes": true
      },
      "mixed_process_output": {
        "retention": "inline-extension-base64",
        "channels": [
          "stdout",
          "stderr"
        ],
        "extraction_rules": []
      }
    },
    "arcgrav.adapters:evidence_class": "provider-free-mock-model-execution",
